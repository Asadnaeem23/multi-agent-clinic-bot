# Database
DATABASE_URL=sqlite:///./app.db

# Provider keys (they can also be entered in Admin > Settings)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional OpenRouter attribution headers
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=AI Customer Support

# Use a comma-separated origin list in production.
CORS_ORIGINS=http://localhost:8001
